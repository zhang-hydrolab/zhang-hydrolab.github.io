{
  "name": "@zhang-hydrolab/backend",
  "version": "1.0.0",
  "private": true,
  "description": "Content database, archive and admin service for the Large Scale Hydrology group website. No runtime npm dependencies.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.mjs\"",
    "db:rebuild": "node --disable-warning=ExperimentalWarning src/cli.mjs db:rebuild",
    "db:status": "node --disable-warning=ExperimentalWarning src/cli.mjs db:status",
    "export": "node --disable-warning=ExperimentalWarning src/cli.mjs export",
    "release:list": "node --disable-warning=ExperimentalWarning src/cli.mjs release:list",
    "release:create": "node --disable-warning=ExperimentalWarning src/cli.mjs release:create",
    "release:verify": "node --disable-warning=ExperimentalWarning src/cli.mjs release:verify"
  }
}
