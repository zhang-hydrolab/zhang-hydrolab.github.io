# Durable content. Fixed line endings keep content hashes identical on Windows,
# macOS and Linux, and keep diffs readable.
backend/content/*.ndjson text eol=lf
backend/archive/*.ndjson text eol=lf
backend/archive/releases/*.ndjson text eol=lf

*.gz binary
*.webp binary
*.woff2 binary

# Generated by scripts/publish.mjs. Hidden from language stats and collapsed in diffs.
/*.html linguist-generated
/news/** linguist-generated
/assets/** linguist-generated
/media/** linguist-generated
/api/** linguist-generated
/.published.json linguist-generated
/sitemap.xml linguist-generated
